shed_number_int_exp as power_numerator\n  slashed_number_int_exp = slashed_number / (lparen slashed_number_named_int_exp as int_exp rparen)\n  slashed_number_named_int_exp = (lparen slashed_number_int_exp rparen) / slashed_number_int_exp\n  unit_and_power = unit [power]\n  sqrt_sequence = \"sqrt\" lparen prefixes_units_int_exp as sqrt rparen\n  sqrt_dimensions = \"sqrt\" lparen dimension_rules_int_exp as sqrt rparen\n  extended_prefixed_units = extender [spaces] prefixes_units_int_exp as sequence\n  powered_dimensions = dimensions [power]\n\n  prefixes_units = (sqrt_sequence [extended_prefixed_units]) / (\"1\" as unit [extended_prefixed_units]) / (unit_and_power extended_prefixed_units) / (unit_and_power end_guard) / (double_letter_prefixes unit_and_power extended_prefixed_units) / (double_letter_prefixes unit_and_power) / (single_letter_prefixes unit_and_power extended_prefixed_units) / (single_letter_prefixes unit_and_power)\n\n  wrapper_prefixes_units_value = int_exp_prefixes_units / prefixes_units_int_exp\n  int_exp_prefixes_units = lparen [spaces] named_int_exp_prefixes_units as int_exp [spaces] rparen\n  prefixes_units_named_int_exp = (lparen as open_paren [spaces] wrapper_prefixes_units_value as int_exp [spaces] rparen as close_paren)\n  named_int_exp_prefixes_units = (prefixes_units_named_int_exp as int_exp [(prefixes_units_int_exp / extended_prefixed_units)]) / prefixes_units_int_exp\n\n  implicit_extended = (prefixes_units as first_set spaces as extender prefixes_units as second_set) / (int_exp_prefixes_units as first_int_exp_set [spaces] int_exp_prefixes_units as second_int_exp_set) / (prefixes_units as first_set [spaces] int_exp_prefixes_units as second_int_exp_set) / (int_exp_prefixes_units as first_int_exp_set [spaces] prefixes_units as second_set)\n\n  prefixes_units_int_exp = (implicit_extended as implicit_extended [spaces] [prefixes_units_int_exp as sequence]) / (implicit_extended as implicit_extended [spaces] extender [spaces] [prefixes_units_int_exp as sequence]) / (int_exp_prefixes_units [spaces] extender [spaces] [prefixes_units_int_exp as sequence]) / (prefixes_units [spaces] extender [spaces] [prefixes_units_int_exp as sequence]) / (int_exp_prefixes_units [prefixes_units_int_exp as sequence]) / (prefixes_units [prefixes_units_int_exp as sequence])\n\n  dimension_rules = (sqrt_dimensions / powered_dimensions) [extended_dimension_rules]\n  extended_dimension_rules = [spaces] extender [spaces] dimension_rules_int_exp as sequence\n  int_exp_dimension_rules = lparen dimension_rules_named_exp as int_exp rparen [extended_dimension_rules]\n  dimension_rules_named_exp = ((lparen as open_paren dimension_rules_int_exp as int_exp rparen as close_paren) as int_exp [spaces] (dimension_rules_int_exp / extended_dimension_rules) as sequence) / dimension_rules_int_exp\n\n  dimension_rules_int_exp = (dimension_rules as first_set spaces as extender dimension_rules as second_set [dimension_rules_int_exp]) / (dimension_rules as first_set [spaces] int_exp_dimension_rules as second_int_exp_set [dimension_rules_int_exp]) / (int_exp_dimension_rules as first_int_exp_set [spaces] dimension_rules as second_set [dimension_rules_int_exp]) / (int_exp_dimension_rules as first_int_exp_set [spaces] int_exp_dimension_rules as second_int_exp_set [dimension_rules_int_exp]) / int_exp_dimension_rules / dimension_rules\n\n  expression = prefixes_units_int_exp / dimension_rules_int_exp / (single_letter_prefixes hyphen) / (double_letter_prefixes hyphen)\n\n  entry expression: expression\n\n  test expression {\n    accept \"mm*s^-2\"\n    accept \"sqrt(Hz)\"\n    accept \"K/(kg*m)\"\n    accept \"p-\"\n    accept \"(m)(s)\"\n    accept \"mm*\"\n    accept \"sqrt(sqrt(m))\"\n    reject \"que?\"\n    reject \"m2\"\n    reject \"dim_Ldim_M\"\n  }\n}\n","source_hash":"3fb5a2ab7d214410c5659cdef1c0b1251eb99c7d57496610f43b4fb23b5cd020","compiler_version":"1.3.108","checksum":"sha256:b1497bdaff9a9bdf5bd92e7a0354200a8dfa54f91c9cdf3c254537e95ed883cf"}
