suite smoke for entry expression {
  accept "m"
  accept "mm"
  accept "um"
  accept "kg"
  accept "mm*s^-2"
  accept "sqrt(Hz)"
  accept "K/(kg*m)"
  accept "Hz^10*darcy^100"
  accept "mW*cm^(-2)"
  accept "p-"
  accept "1"
  accept "(m)(s)"
  accept "m s"
  accept "km//s"
  accept "sqrt(sqrt(m))"
  accept "ton-force (2000 lb)"
  accept "dim_Theta*dim_L^2"
  reject "que?"
  reject "m2"
  reject "dim_Ldim_M"
  reject "(cm)^3"
  reject "sqrt(m)^2"
}
