# UnitsDB short names are complete tokens, not implicit prefix suffixes.
suite short_names for entry expression {
  accept "arc_degree"
  accept "arc_degree^2"
  accept "arc_degree/s"
  accept "sqrt(arc_degree)"
  accept "(arc_degree)"
  accept "rad*arc_degree"
  accept "gal (UK)"
  accept "gal (US)"
  accept "pascal"
  accept "farad"
  accept "carat"
  accept "katal"
  accept "minute"
  accept "decade"
  accept "ampere"
  accept "yard"
  accept "pas*cal"
  accept "mil (length)"
  accept "0C_cm_Hg"
  accept "inch_cubed"
  accept "atomic_unit_of_momentum"
  reject "xarc_degree"
  reject "arc_degree_extra"
  reject "karc_degree"
  reject "kiloarc_degree"
  reject "arc_degree/"
  reject "arc_degree^"
}
